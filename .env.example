# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit real keys.

# --- LLM provider (Sarvam AI) ---
# Get your key from https://dashboard.sarvam.ai
LLM_API_KEY=your_sarvam_api_key_here
# See https://docs.sarvam.ai/api/getting-started/models for the current model list.
LLM_MODEL=sarvam-105b

# --- Embeddings (local, free, no API key required) ---
# Leave blank to use the built-in default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=

# --- Paths (defaults work for local dev from project root) ---
DATA_DIR=data
VECTORSTORE_DIR=vectorstore

# --- Retrieval settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
