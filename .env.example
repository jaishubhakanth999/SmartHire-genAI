# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- LLM provider (Sarvam AI) ---
LLM_API_KEY=your_sarvam_api_key_here
# See https://docs.sarvam.ai/api/getting-started/models for the current list.
# sarvam-105b is the flagship general-purpose model (recommended default).
LLM_MODEL=sarvam-105b

# --- Embeddings ---
# Local, free, no API key needed. Leave blank to use the built-in default
# (sentence-transformers/all-MiniLM-L6-v2), or set your own HuggingFace model id.
EMBEDDING_MODEL=

# --- Paths (defaults are fine for local dev) ---
DATA_DIR=data
VECTORSTORE_DIR=vectorstore

# --- Retrieval settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
