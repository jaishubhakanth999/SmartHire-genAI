# Copy to backend/.env and fill in. .env is gitignored -- never commit real keys.

# --- Supabase (Settings -> API in your Supabase project dashboard) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# --- LLM provider (Sarvam AI) ---
LLM_API_KEY=your_sarvam_api_key_here
LLM_MODEL=sarvam-105b

# --- Embeddings (local, free, no API key required, no torch -- ONNX via fastembed) ---
# Leave blank to use the built-in default: BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=

# --- Retrieval settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000
